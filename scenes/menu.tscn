[node name="i_16" type="Node2D" parent="About/Characters/AboutExeller"]
	script = ExtResource("4")
	depth = -4000
	position = Vector2(23.0, 60.0)
	gm_name = "obj_menu_abouttext"
	sprite_name = "spr_letter1"
	text = "\\exeller~ can create \\clones~ that \nreveal the location of survivors \nwithin their field of view, up \nto two and \\teleport~ to each one, \nreplacing them and allowing \nhim to track nearest survivors\nthis ability provides exeller \ngreat strategic potential in \nall eniviorments. he can also \ncancel his spin, this will \nallow him to avoid bouncing \noff of survivors.all killers \ncan do that. \n \nexeller is an antagonist of  \nsonic.exe spirits of hell and \nits sequel, sally.exe whisper \nof soul, by №dan the patient \nbear~  in 2018 and 2021 \nrespectively"

