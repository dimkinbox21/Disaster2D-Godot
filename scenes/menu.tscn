[node name="i_32" type="Node2D" parent="About/Characters/AboutChaos"]
	script = ExtResource("4")
	depth = -3800
	position = Vector2(23.0, 60.0)
	gm_name = "obj_menu_abouttext"
	sprite_name = "spr_letter1"
	text = "/chaos~ has medium range attacks\nthat deal low damage. his air\nattack is a /dash~, that can be\naimed and /redirected~ by dashing\nagain in the direction he's\nfacing upon impacting with a\nsurface. chaos' special is the\n/form of liquid~, which allows\nhim accelerating faster and\ntracking nearest survivors.\ngetting hit cancels this form.\nhe can also cancel his spin,\nthis will allow him to avoid\nbouncing off of survivors.\nall killers can do that. \n\nchaos is an antagonist of    \nsonic.exe the stone of\ndarkness, which originally   \ncame to be in 2018, and was\ndeveloped by №hamster man"

