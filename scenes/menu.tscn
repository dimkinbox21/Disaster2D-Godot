[node name="i_40" type="Node2D" parent="About/Characters/AboutExe"]
	script = ExtResource("4")
	depth = -3700
	position = Vector2(23.0, 60.0)
	gm_name = "obj_menu_abouttext"
	sprite_name = "spr_letter1"
	text = "\\sonic.exe~ can become        \n\\invisible~ for survivors,   \nduring this ability he is    \nconstantly tracking nearest \nsurvivor and is immune to all\nincoming damage. he can also\ncancel his spin, this will   \nallow him to avoid bouncing  \noff of survivors. all killers\ncan do that. \n \nsonic.exe~ is a collective  \nimage of all takes on        \nsonic.exe creepypasta. he is \nthe original, his moveset \nmostly draws from original   \nsonic.exe the disaster."

