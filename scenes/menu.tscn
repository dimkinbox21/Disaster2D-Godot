[node name="i_24" type="Node2D" parent="About/Characters/AboutExetior"]
	script = ExtResource("4")
	depth = -3900
	position = Vector2(23.0, 60.0)
	gm_name = "obj_menu_abouttext"
	sprite_name = "spr_letter1"
	text = "\\exetior~ is slightly slower  \nthan the other killers, but  \nhe is capable of making that \nup with his great offense.he\nhas a \\stomp~, it sends out \na shockwave upon landing,  \ndealing damage. his special  \nis placing down a \\black ring~,\nthat allows him to track    \nnearest survivors. however,  \nblack rings can be countered \nby taking them with 5 rings  \nin stock. he can also cancel \nhis spin, this will allow him\nto avoid bouncing off of     \nsurvivors. all killers can do\nthat. \n \nexetior is an antagonist of   \nsonic.exe nightmare universe,\nmade by @jаizkoys~ in 2017"

